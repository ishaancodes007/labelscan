# Server-only. Never prefix with NEXT_PUBLIC_.
# URL of the Python identity service (backend/). If unset or unreachable, /api/analyze falls back to the TypeScript path.
PYTHON_API_BASE_URL=http://127.0.0.1:8000

# --- Python service (backend/) ---
# Path to the SQLite dictionary built by scripts/import_cosing.py (default: backend/data/inci.sqlite, auto-built from the seed list).
# INCI_DB_PATH=backend/data/inci.sqlite
# 1 = live PubChem lookups (identity confirmation); 0 = off.
# PUBCHEM_ENABLED=1

# --- Not used yet (planned for the AI resolution agent, Phase 6) ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_RESOLVER_MODEL=

# Python service only (never exposed to the browser): opt-in AI helper for unrecognized ingredient names.
# There is no default model; choose one from Anthropic's models overview.
# ANTHROPIC_API_KEY=
# ANTHROPIC_RESOLVER_MODEL=
