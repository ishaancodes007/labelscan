# Server-only. Never prefix with NEXT_PUBLIC_.
# URL of the Python identity service (backend/). If unset or unreachable, /api/analyze falls back to the TypeScript path.
PYTHON_API_BASE_URL=http://127.0.0.1:8000
# Shared secret sent to the Python service as x-service-token. Required on any public deployment; must equal the service's SERVICE_TOKEN.
# PYTHON_API_TOKEN=
# How long /api/analyze waits for the Python service before falling back to basic matching (default 8000). A sleeping free-tier host needs about 60000.
# RESOLVER_TIMEOUT_MS=8000

# --- Python service (backend/) ---
# Path to the SQLite dictionary built by scripts/import_cosing.py (default: backend/data/inci.sqlite, auto-built from the seed list).
# INCI_DB_PATH=backend/data/inci.sqlite
# 1 = live PubChem lookups (identity confirmation); 0 = off.
# PUBCHEM_ENABLED=1
# If set, every /v1 request must carry this value in the x-service-token header (401 otherwise). Leave unset for local development.
# SERVICE_TOKEN=

# Python service only (never exposed to the browser): opt-in AI helper for unrecognized ingredient names.
# There is no default model; choose one from Anthropic's models overview.
# ANTHROPIC_API_KEY=
# ANTHROPIC_RESOLVER_MODEL=

# OCR: there are no consent flags because there is no server OCR path. Photos are read in the browser (Tesseract.js, assets copied to public/tesseract at build) and are never uploaded.
